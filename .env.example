# 공공데이터포털 - 소상공인시장진흥공단 상가(상권)정보 API
# https://www.data.go.kr/data/15012005/openapi.do
# 발급 시 인코딩키/디코딩키가 둘 다 나온다. 쿼리스트링을 직접 조립하면 인코딩키,
# requests/axios처럼 params를 재인코딩하는 클라이언트면 디코딩키를 쓴다.
SBIZ_API_KEY_ENCODED=
SBIZ_API_KEY_DECODED=
SBIZ_ENDPOINT=https://apis.data.go.kr/B553077/api/open/sdsc2

# 서울 열린데이터광장
# https://data.seoul.go.kr/
SEOUL_API_KEY=
SEOUL_ENDPOINT=http://openapi.seoul.go.kr:8088
