# 공공데이터포털 - 소상공인시장진흥공단 상가(상권)정보 API
# https://www.data.go.kr/data/15012005/openapi.do
# 발급 시 인코딩키/디코딩키가 둘 다 나온다. 쿼리스트링을 직접 조립하면 인코딩키,
# requests/axios처럼 params를 재인코딩하는 클라이언트면 디코딩키를 쓴다.
SBIZ_API_KEY_ENCODED=
SBIZ_API_KEY_DECODED=
SBIZ_ENDPOINT=https://apis.data.go.kr/B553077/api/open/sdsc2

# 서울 열린데이터광장
# https://data.seoul.go.kr/
SEOUL_API_KEY=
SEOUL_ENDPOINT=http://openapi.seoul.go.kr:8088

# --- 한국관광공사 TourAPI (KorService2) ---
# G-X(좌표 진실) 기준점용. 공공데이터포털 발급. 일반 인증키(Encoding) 그대로 넣는다.
TOUR_API_KEY_ENCODED=
TOUR_ENDPOINT=https://apis.data.go.kr/B551011/KorService2

# --- odcloud (data.go.kr 파일데이터의 오픈API 래퍼) ---
# 백년가게 지정리스트 = G-A 정답. 인증키는 공공데이터포털 계정 단위라 TOUR_API_KEY_ENCODED와 같다.
ODCLOUD_BASE=https://api.odcloud.kr/api
ODCLOUD_NS_100YR=15132695/v1
